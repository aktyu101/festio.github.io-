{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "version": "7.0.0",
  "name": "Commercial Web Service Color Design System",
  "description": "2-Tier Color Token System (Primitives -> Light & Dark Semantics), WCAG 2.2 Certified",
  "primitive": {
    "slate": {
      "0":   { "$value": "#FFFFFF", "$type": "color" },
      "25":  { "$value": "#FCFDFF", "$type": "color" },
      "50":  { "$value": "#F8FAFC", "$type": "color" },
      "75":  { "$value": "#F1F5F9", "$type": "color" },
      "100": { "$value": "#E2E8F0", "$type": "color" },
      "150": { "$value": "#CBD5E1", "$type": "color" },
      "200": { "$value": "#94A3B8", "$type": "color" },
      "300": { "$value": "#64748B", "$type": "color" },
      "400": { "$value": "#475569", "$type": "color" },
      "500": { "$value": "#334155", "$type": "color" },
      "600": { "$value": "#1E293B", "$type": "color" },
      "700": { "$value": "#172033", "$type": "color" },
      "800": { "$value": "#0F172A", "$type": "color" },
      "900": { "$value": "#090D16", "$type": "color" },
      "950": { "$value": "#030712", "$type": "color" }
    },
    "blue": {
      "25":  { "$value": "#F5F8FF", "$type": "color" },
      "50":  { "$value": "#EFF4FF", "$type": "color" },
      "100": { "$value": "#DBE6FE", "$type": "color" },
      "200": { "$value": "#BFCFFD", "$type": "color" },
      "300": { "$value": "#93B0FB", "$type": "color" },
      "400": { "$value": "#6089F7", "$type": "color" },
      "500": { "$value": "#3B66F1", "$type": "color" },
      "600": { "$value": "#2550E5", "$type": "color" },
      "700": { "$value": "#1D3EC7", "$type": "color" },
      "800": { "$value": "#1B33A1", "$type": "color" },
      "900": { "$value": "#1A2D7E", "$type": "color" }
    },
    "emerald": {
      "50":  { "$value": "#ECFDF5", "$type": "color" },
      "200": { "$value": "#A7F3D0", "$type": "color" },
      "400": { "$value": "#34D399", "$type": "color" },
      "700": { "$value": "#047857", "$type": "color" }
    },
    "amber": {
      "50":  { "$value": "#FFFBEB", "$type": "color" },
      "200": { "$value": "#FDE68A", "$type": "color" },
      "400": { "$value": "#FBBF24", "$type": "color" },
      "700": { "$value": "#B45309", "$type": "color" }
    },
    "rose": {
      "50":  { "$value": "#FFF1F2", "$type": "color" },
      "200": { "$value": "#FECDD3", "$type": "color" },
      "400": { "$value": "#FB7185", "$type": "color" },
      "600": { "$value": "#E11D48", "$type": "color" },
      "700": { "$value": "#BE123C", "$type": "color" }
    },
    "sky": {
      "50":  { "$value": "#F0F9FF", "$type": "color" },
      "200": { "$value": "#BAE6FD", "$type": "color" },
      "400": { "$value": "#38BDF8", "$type": "color" },
      "700": { "$value": "#0369A1", "$type": "color" }
    }
  },
  "semantic": {
    "light": {
      "bg": {
        "canvas": { "$value": "{primitive.slate.50}", "$type": "color" },
        "surface": { "$value": "{primitive.slate.0}", "$type": "color" },
        "subtle": { "$value": "{primitive.slate.75}", "$type": "color" }
      },
      "text": {
        "primary": { "$value": "{primitive.slate.800}", "$type": "color" },
        "secondary": { "$value": "{primitive.slate.400}", "$type": "color" },
        "tertiary": { "$value": "{primitive.slate.300}", "$type": "color" },
        "brand": { "$value": "{primitive.blue.600}", "$type": "color" }
      },
      "border": {
        "subtle": { "$value": "{primitive.slate.100}", "$type": "color" },
        "default": { "$value": "{primitive.slate.150}", "$type": "color" },
        "focus": { "$value": "{primitive.blue.600}", "$type": "color" }
      },
      "action": {
        "primaryBg": { "$value": "{primitive.blue.600}", "$type": "color" },
        "primaryHover": { "$value": "{primitive.blue.700}", "$type": "color" }
      }
    },
    "dark": {
      "bg": {
        "canvas": { "$value": "{primitive.slate.900}", "$type": "color" },
        "surface": { "$value": "{primitive.slate.800}", "$type": "color" },
        "subtle": { "$value": "{primitive.slate.700}", "$type": "color" }
      },
      "text": {
        "primary": { "$value": "{primitive.slate.50}", "$type": "color" },
        "secondary": { "$value": "{primitive.slate.200}", "$type": "color" },
        "tertiary": { "$value": "{primitive.slate.300}", "$type": "color" },
        "brand": { "$value": "{primitive.blue.400}", "$type": "color" }
      },
      "border": {
        "subtle": { "$value": "{primitive.slate.600}", "$type": "color" },
        "default": { "$value": "{primitive.slate.500}", "$type": "color" },
        "focus": { "$value": "{primitive.blue.400}", "$type": "color" }
      },
      "action": {
        "primaryBg": { "$value": "{primitive.blue.500}", "$type": "color" },
        "primaryHover": { "$value": "{primitive.blue.400}", "$type": "color" }
      }
    }
  }
}